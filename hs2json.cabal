cabal-version:      3.0
name:               hs2json
version:            0.1.0.0
synopsis:           Biblioteca JSON com pretty printing e testes QuickCheck
description:        Projeto da disciplina de Programacao Funcional (Haskell):
                    tipo JValue, biblioteca Prettify, renderizador PrettyJSON
                    e suite de testes baseada em propriedades.
license:            BSD-3-Clause
author:             Keven Gomes, Leonardo Ferreira
category:           Text
build-type:         Simple

common warnings
    ghc-options: -Wall

-- ATENCAO: todos os modulos ja estao listados. Nao edite este arquivo
-- sem avisar a dupla (evita conflitos de merge).
library
    import:           warnings
    exposed-modules:  SimpleJSON
                      PutJSON
                      Prettify
                      PrettyJSON
    hs-source-dirs:   src
    build-depends:    base >=4.14 && <5
    default-language: Haskell2010

executable hs2json-exe
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5, hs2json
    default-language: Haskell2010

executable hs2json-demo
    import:           warnings
    main-is:          Demo.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5, hs2json
    default-language: Haskell2010


test-suite hs2json-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:    JSONGen
                      JSONProps
                      DocProps
                      PrettyProps
    build-depends:    base >=4.14 && <5, hs2json, QuickCheck
    default-language: Haskell2010
